# 's3backup', 's3restore'
APP_TEMPLATE=
APP_KEY=
SERVER_NID=
# 'console', 'slack', 'telega'
MESSAGE_CHANNEL=

# Backup
TIMEZONE=Europe/Moscow
BACKUP_NAME=
BACKUP_PATHS=/var/www/html
BACKUP_TAR_OPTION=--exclude=/var/www/html/sites/default/files/translations/*

# Restore
BACKUP_TAR_OPTION_RESTORE=

# DB Settings:
DBFILE=/var/www/html/.db.sql
DBDUMP_DIR=/var/www/html/.db

# '', 'drush', 'mysql', 'postgre', 'mydumper'
DBDUMP=
DBNAME=
DBUSER=drupal
DBPASS=
DBHOST=
# todo for mysql
DBSKIP=
# For mydumper
MYDUMPER_THREADS=
MYDUMPER_CHUNK_SIZE=
# For myloader
MYLOADER_THREADS=
MYLOADER_QUERIES_PER_TRANSACTION=
# 'mysql' todo for 'drush', 'postgre'
DBRESTORE=

# AWS Settings
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_CLI_PARAMS=

# Message
WEBHOOK=
MATTERMOST_HOST=
MATTERMOST_HOOK=
TELEGA_TOKEN=
TELEGA_CHANNEL=
MQTT_HOST=
MQTT_PORT=
MQTT_USER=
MQTT_PASS=
